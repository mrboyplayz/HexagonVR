    pistol_casing_mesh="https://www.hexagon.pw/asset/?id=109894682585548",
    pistol_mesh="https://www.hexagon.pw/asset/?id=89107029148183",
    pistol_texture="https://www.hexagon.pw/asset/?id=2492931263",
    reload="https://www.hexagon.pw/asset/?id=3821789416",
    rifle_casing_mesh="https://www.hexagon.pw/asset/?id=97009576578556",
    slide_mesh="https://www.hexagon.pw/asset/?id=72960610154574",
    slide_pull="https://www.hexagon.pw/asset/?id=3719415248",
    slide_release="https://www.hexagon.pw/asset/?id=265294983",
    slide_texture="https://www.hexagon.pw/asset/?id=2492931686",
}
local offline=game:GetService("ReplicatedStorage"):FindFirstChild("HexagonVROfflineAssets")
if offline and offline.Value then
    local files={
        ak_bolt_mesh="ak_bolt_mesh.mesh",
        ak_fire="ak_fire.mp3",
        ak_magazine_mesh="ak_magazine_mesh.mesh",
        ak_mesh="ak_mesh.mesh",
        ak_texture="ak_texture.png",
        casing_bounce="casing_bounce.mp3",
        casing_texture="casing_texture.png",
        crowbar_hit="crowbar_hit.mp3",
        crowbar_mesh="crowbar_mesh.mesh",
        crowbar_swing="crowbar_swing.mp3",
        crowbar_texture="crowbar_texture.png",
