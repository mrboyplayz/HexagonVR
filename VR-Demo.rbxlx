        magazine_mesh="magazine_mesh.mesh",
        magazine_out="magazine_out.mp3",
        pistol_casing_mesh="pistol_casing_mesh.mesh",
        pistol_mesh="pistol_mesh.mesh",
        pistol_texture="pistol_texture.png",
        reload="reload.mp3",
        rifle_casing_mesh="rifle_casing_mesh.mesh",
        slide_mesh="slide_mesh.mesh",
        slide_pull="slide_pull.mp3",
        slide_release="slide_release.mp3",
        slide_texture="slide_texture.png",
    }
    for key,file in pairs(files)do assets[key]="rbxasset://HexagonVRWeapons/"..file end
end
return assets
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX40e4751a54f2498880de5acac94df4ff"><Properties><string name="Name">VRHats</string><ProtectedString name="Source">-- Shared wearable instances: detach, hold at the touched point, and re-equip.
local M={}
local Players=game:GetService("Players")
local Geometry=require(game:GetService("ReplicatedStorage"):WaitForChild("HexagonVRWeaponGeometry"))
local function value(kind,name,initial,parent)
    local node=Instance.new(kind);node.Name=name;node.Value=initial;node.Parent=parent;return node
end
local function walk(node,fn)
    for _,child in ipairs(node:GetChildren())do fn(child);walk(child,fn)end
end
local function isHat(node)return node:IsA("Hat")or node:IsA("Accessory")end
local function inside(part,hat)return part and(part==hat or part:IsDescendantOf(hat))end
local function removeTouchPickup(item)
    walk(item.model,function(node)if node:IsA("TouchTransmitter")then node:Destroy()end end)
end
local function detachJoints(item)
    local function check(joint)
        if joint:IsA("JointInstance")then
            local a,b=inside(joint.Part0,item.model),inside(joint.Part1,item.model)
            if a~=b and(a or b)then joint.Part0=nil;joint.Part1=nil;joint:Destroy()end
        end
    end
    walk(item.model,check)
    -- Native hats can leave an attachment in a previous wearer's character.
    for _,player in ipairs(Players:GetPlayers())do if player.Character then walk(player.Character,check)end end
end
function M.new(weapons,config)
    local self={byHat={}}
    function self:markVR(item,player)
        item.vrCreator=item.vrCreator or player
    end
    function self:register(hat,wearer)
        if self.byHat[hat]then return self.byHat[hat]end
        if not isHat(hat)then return end
        local root=hat:FindFirstChild("Handle");if not root or not root:IsA("BasePart")then return end
        local character=wearer and wearer.Character or hat.Parent
        local head=character and character:FindFirstChild("Head")
        if not head or not wearer then hat:Destroy();return end
        local offset=head and head.CFrame:toObjectSpace(root.CFrame)or CFrame.new(0,.5,0)
        local item={kind="Hat",model=hat,root=root,layout=Geometry.Hat,grip=CFrame.new(),spawn=root.CFrame,lastUse=tick(),hitAt={},hatParts={},hatOffsets={},wearerCharacter=head and character or nil,headOffset=offset}
        item.owner=value("ObjectValue","Owner",nil,hat);item.hand=value("StringValue","Hand","",hat)
        item.heldGrip=value("CFrameValue","HeldGrip",CFrame.new(),hat)
        item.roundValue=value("IntValue","Rounds",0,hat);item.mount=value("ObjectValue","MountedTo",nil,hat)
        item.wearer=value("ObjectValue","Wearer",wearer,hat)
        value("StringValue","VRKind","Hat",hat);value("CFrameValue","HeadOffset",offset,hat)
        walk(hat,function(part)
            if part:IsA("BasePart")then
                item.hatParts[#item.hatParts+1]=part;item.hatOffsets[part]=root.CFrame:toObjectSpace(part.CFrame)
                value("CFrameValue","VRHatOffset",item.hatOffsets[part],part)
            end
        end)
        self.byHat[hat]=item;weapons.items[#weapons.items+1]=item
        if not head then hat.Parent=weapons.folder;root.CanCollide=true end
        return item
    end
    function self:detach(item)
        detachJoints(item);item.wearer.Value=nil;item.wearerCharacter=nil;item.model.Parent=weapons.folder
        removeTouchPickup(item)
        for _,part in ipairs(item.hatParts)do part.CanCollide=false end
    end
    function self:attach(item,player)
        local character=player.Character;local head=character and character:FindFirstChild("Head")
        local humanoid=character and character:FindFirstChild("Humanoid")
        if not head or not humanoid or humanoid.Health&lt;=0 then return false end
        detachJoints(item)
        local frame=head.CFrame*item.headOffset
        weapons:move(item,frame)
        if item.model:IsA("Hat")then item.model.AttachmentPoint=item.headOffset:inverse()*CFrame.new(0,head.Size.y/2,0)end
        item.owner.Value=nil;item.hand.Value="";item.wearer.Value=player;item.wearerCharacter=character
        item.model.Parent=character
        detachJoints(item)
        weapons:move(item,frame)
        local joint=Instance.new("Weld");joint.Name="HexagonVRHatWeld";joint.Part0=head;joint.Part1=item.root;joint.C0=item.headOffset;joint.C1=CFrame.new();joint.Parent=item.root
        weapons:anchor(item,false)
        for _,part in ipairs(item.hatParts)do part.CanCollide=false;part.Velocity=Vector3.new();part.RotVelocity=Vector3.new()end
        item.lastUse=tick();item.previous=nil;return true
    end
    function self:tryEquip(item,actor)
        local anchor=(item.root.CFrame*item.headOffset:inverse()).p
        local best,distance=nil,config.HatEquipRadius or 1.1
        for _,player in ipairs(Players:GetPlayers())do
            local character=player.Character;local head=character and character:FindFirstChild("Head");local humanoid=character and character:FindFirstChild("Humanoid")
            if head and humanoid and humanoid.Health&gt;0 then
                local gap=(head.Position-anchor).magnitude
                if gap&lt;distance then
                    local hit=weapons:trace(anchor,head.Position-anchor,actor.Character)
                    if not hit or hit:IsDescendantOf(character)then best=player;distance=gap end
                end
            end
        end
        return best and self:attach(item,best)or false
    end
    function self:step(item)
        if item.wearerCharacter and item.model.Parent==item.wearerCharacter then return end
        if not item.vrCreator then item.model:Destroy();return end
        if item.model.Parent~=weapons.folder then
            -- The 2015 engine also auto-equips loose Hats on body contact.
            -- Only an explicit grip release near a head may equip a VR hat.
            local frame=item.freeFrame or item.lastWorldFrame or item.root.CFrame
            self:detach(item);weapons:anchor(item,item.owner.Value~=nil);weapons:move(item,frame)
            item.root.CanCollide=item.owner.Value==nil
            item.root.Velocity=item.velocity or Vector3.new()
        end
        removeTouchPickup(item)
        if not item.owner.Value then item.freeFrame=item.root.CFrame end
        if not item.owner.Value and item.root.Position.y&lt;-100 then
            self:detach(item);weapons:anchor(item,false);weapons:move(item,CFrame.new((config.SpawnPosition or Vector3.new(0,0,-5))+Vector3.new(0,3,0)))
            item.root.CanCollide=true;item.root.Velocity=Vector3.new();item.root.RotVelocity=Vector3.new()
        end
    end
    local function character(player,char)
        local function added(node)
            if isHat(node)then spawn(function()wait(.1);if node.Parent==char then self:register(node,player)end end)end
        end
        for _,node in ipairs(char:GetChildren())do added(node)end
        char.ChildAdded:connect(added)
        spawn(function()
            local humanoid=char:FindFirstChild("Humanoid")or char:WaitForChild("Humanoid")
            humanoid.Died:connect(function()
                for _,item in pairs(self.byHat)do
                    if item.wearerCharacter==char and item.model.Parent==char then
                        if weapons.players[player]then self:markVR(item,player)end
                        if item.vrCreator then self:detach(item);weapons:anchor(item,false);item.root.CanCollide=true
                        else item.model:Destroy()end
                    end
                end
            end)
        end)
    end
    local function playerAdded(player)
        player.CharacterAdded:connect(function(char)character(player,char)end)
        if player.Character then character(player,player.Character)end
    end
    Players.PlayerAdded:connect(playerAdded)
    for _,player in ipairs(Players:GetPlayers())do playerAdded(player)end
    local function groundAdded(node)
        if not isHat(node)then return end
        spawn(function()
            wait(.2);if not node.Parent or self.byHat[node]then return end
            for _,player in ipairs(Players:GetPlayers())do if player.Character and node:IsDescendantOf(player.Character)then return end end
            local parent=node.Parent
            if parent:FindFirstChild('Humanoid')and parent:FindFirstChild('Head')then return end
            node:Destroy()
        end)
    end
    workspace.DescendantAdded:connect(groundAdded)
    workspace.ChildAdded:connect(groundAdded)
    walk(workspace,groundAdded)
    return self
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX49f556186f18413e94adf75e2302d4ce"><Properties><string name="Name">VRConfig</string><ProtectedString name="Source">return {
    AllowedUserIds = {}, -- Empty allows every player with a local VR helper.
    AutoEnable = false,
    TrackingTimeout = 2,
    WalkSpeed = 12,
    MaxReach = 12,
    ArmRotationDegrees = 90,
    Weapons = {
        Enabled = true,
        SpawnPosition = Vector3.new(0,0,-5),
        GrabRadius = 2.5,
        DistanceGrabRange = 6,
        HatGrabRadius = .65,
        HatEquipRadius = 1.1,
        MagazineCapacity = 12,
        SpareMagazines = 4,
        CrowbarDamage = 20,
        SwingSpeed = 5,
        MaxHandSpeed = 65,
        HitCooldown = .5,
        GunDamage = 25,
        FireInterval = .18,
        Range = 300,
        RespawnSeconds = 90,
    },
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2ba028ac26be457d9bbedb19c21e3329"><Properties><string name="Name">VRChat</string><ProtectedString name="Source">-- Public chat submitted by the game itself. No desktop keyboard input.
local Chat={}
function Chat.start(remote,config,isActive,command)
    local Players=game:GetService("Players")
    local Run=game:GetService("RunService")
    local Service=game:GetService("Chat")
    local jobs,last,completed={},{},{}
    local function reply(player,id,ok,text)
        completed[player]={id=id,ok=ok,text=text}
        if player.Parent then remote:FireClient(player,"chatResult",id,ok,text)end
    end
    local function alive(player,job)
        return player.Parent and jobs[player]==job and not job.expired
    end
    local function filtered(text,recipient)
        local ok,value=pcall(function()return Service:FilterStringForPlayerAsync(text,recipient)end)
        return ok and type(value)=="string"and #value&gt;0 and #value&lt;=2048 and value or nil
    end
    remote.OnServerEvent:connect(function(player,action,data)
        if action~="chat"then return end
        if type(data)~="table"or type(data.id)~="number"or data.id~=math.floor(data.id)or data.id&lt;1 or data.id&gt;999999 then return end
        local id=data.id
        if completed[player]and completed[player].id==id then
            local row=completed[player];remote:FireClient(player,"chatResult",id,row.ok,row.text);return
        end
        if jobs[player]then
            if jobs[player].id~=id then reply(player,id,false,"A message is still being sent.")end
            return
        end
        if type(data.text)~="string"or #data.text&gt;140 or data.text:find("%c")then reply(player,id,false,"Enter a message of up to 140 characters.");return end
        local text=data.text:match("^%s*(.-)%s*$")
        if text==""then reply(player,id,false,"Enter a message first.");return end
        if last[player]and tick()-last[player]&lt;(config.ChatInterval or 1.5)then reply(player,id,false,"Please wait a moment before sending again.");return end
        local lower=string.lower(text)
        if lower=="/vr"or lower=="/unvr"then
            last[player]=tick();command(player,lower);reply(player,id,true,"Done.");return
        end
        if text:sub(1,1)=="/"then reply(player,id,false,"This keyboard uses public chat. Use normal chat for other commands.");return end
        if not isActive(player)then reply(player,id,false,"Turn VR on before using this keyboard.");return end
        last[player]=tick()
        local job={id=id,deadline=tick()+(config.ChatTimeout or 12),expired=false,replied=false}
        jobs[player]=job
        spawn(function()
            -- Confirm the sender's own filtered copy before delivering anywhere.
            local own=filtered(text,player)
            if not alive(player,job)then if jobs[player]==job then jobs[player]=nil end;return end
            if not own then jobs[player]=nil;reply(player,id,false,"Chat is unavailable right now. Your text is kept.");return end
            remote:FireClient(player,"chatDisplay",player,own)
            job.replied=true;reply(player,id,true,"Sent.")
            local recipients={}
            for _,recipient in ipairs(Players:GetPlayers())do if recipient~=player then recipients[#recipients+1]=recipient end end
            job.remaining=#recipients
            if job.remaining==0 then jobs[player]=nil;return end
            for _,recipient in ipairs(recipients)do spawn(function()
                local value=filtered(text,recipient)
                if alive(player,job)and recipient.Parent and value then remote:FireClient(recipient,"chatDisplay",player,value)end
                job.remaining=job.remaining-1
                if job.remaining==0 and jobs[player]==job then jobs[player]=nil end
            end)end
        end)
    end)
    Run.Stepped:connect(function()
        for player,job in pairs(jobs)do
            if not job.expired and tick()&gt;job.deadline then
                job.expired=true;jobs[player]=nil
                if not job.replied then reply(player,job.id,false,"Chat took too long. Your text is kept.")end
            end
        end
    end)
    Players.PlayerRemoving:connect(function(player)jobs[player]=nil;last[player]=nil;completed[player]=nil end)
end
return Chat
</ProtectedString></Properties></Item><Item class="Script" referent="RBX7bb9c89fe7874447bb94c73461c7f07d"><Properties><string name="Name">HexagonVRServer</string><ProtectedString name="Source">-- Lua 5.1 / Hexagon 0.217. Each player owns an independent R6 VR session.
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local Run=game:GetService("RunService")
local C=require(script.Parent.VRConfig)
local bodyModule=RS:FindFirstChild("HexagonVRBody")
local Body=bodyModule and require(bodyModule)or nil
local remote=RS:FindFirstChild("HexagonVR")or Instance.new("RemoteEvent")
remote.Name="HexagonVR";remote.Parent=RS
local sessions,requested={},{}
local weapons=C.Weapons and C.Weapons.Enabled and require(script.Parent.VRWeapons).new(C)or nil
local function tell(player,text)remote:FireClient(player,"message",text)end
local function allowed(player)
    local list=C.AllowedUserIds or {}
    if #list==0 then return true end
    for _,id in ipairs(list)do if tonumber(id)==player.userId then return true end end
    return false
end
local function leave(player,reason)
    local state=sessions[player]
    if not state then return end
    sessions[player]=nil
    if weapons then weapons:dropPlayer(player)end
    if state.death then state.death:disconnect()end
    for _,row in ipairs(state.joints)do
        if row.weld and row.weld.Parent then row.weld:Destroy()end
        if row.motor then
            if row.parent.Parent then row.motor.Part0=row.part0;row.motor.Part1=row.part1;row.motor.Parent=row.parent else row.motor:Destroy()end
        end
    end
    if state.humanoid.Parent then
        state.humanoid.AutoRotate=state.autoRotate;state.humanoid.WalkSpeed=state.walkSpeed
        state.humanoid:Move(Vector3.new(),false)
    end
    remote:FireAllClients("mode",player,false,reason)
    print("HEXAGON_VR_OFF",player.Name,reason or"toggle")
end
local function enter(player)
    if sessions[player]then return end
    if not allowed(player)then tell(player,"VR is not enabled for this account in this game's VRConfig.");return end
    local char=player.Character
    local torso=char and char:FindFirstChild("Torso")
    local root=char and char:FindFirstChild("HumanoidRootPart")
    local hum=char and char:FindFirstChild("Humanoid")
    if not torso or not root or not hum or hum.Health&lt;=0 then tell(player,"VR needs a living R6 character.");return end
    local joints={}
    for _,spec in ipairs({{"Neck","Head","head"},{"Left Shoulder","Left Arm","left"},{"Right Shoulder","Right Arm","right"}})do
        local motor=torso:FindFirstChild(spec[1]);local part=char:FindFirstChild(spec[2])
        if not motor or not motor:IsA("Motor6D")or not part then tell(player,"Your R6 neck or shoulder joints are missing.");return end
        joints[#joints+1]={motor=motor,parent=motor.Parent,part=part,key=spec[3],c0=motor.C0,c1=motor.C1,part0=motor.Part0,part1=motor.Part1}
    end
    if Body then
        local motor
        for _,parent in ipairs({root,torso})do for _,candidate in ipairs(parent:GetChildren())do
            if candidate:IsA("Motor6D")and candidate.Part0==root and candidate.Part1==torso then motor=candidate end
        end end
        if not motor then tell(player,"Your R6 body root joint is missing.");return end
        table.insert(joints,1,{motor=motor,parent=motor.Parent,part=torso,key="body",c0=motor.C0,c1=motor.C1,part0=motor.Part0,part1=motor.Part1})
    end
    for _,row in ipairs(joints)do
        row.motor.Parent=nil;row.motor.Part0=nil;row.motor.Part1=nil
        row.weld=Instance.new(row.key=="body"and"Motor6D"or"Weld");row.weld.Name="HexagonVR_"..row.key
        row.weld.Part0=row.key=="body"and root or torso;row.weld.Part1=row.part;row.weld.C0=row.c0;row.weld.C1=row.c1;row.weld.Parent=row.parent
    end
    local state={character=char,torso=torso,root=root,humanoid=hum,joints=joints,autoRotate=hum.AutoRotate,walkSpeed=hum.WalkSpeed,lastSequence=-1,lastPoseAt=tick()+25,remotePoseAt=-math.huge}
    sessions[player]=state;hum.AutoRotate=false;hum.WalkSpeed=C.WalkSpeed
    state.death=hum.Died:connect(function()if sessions[player]==state then leave(player,"death")end end)
    remote:FireAllClients("mode",player,true)
    print("HEXAGON_VR_ON",player.Name)
end
local function command(player,text)
    text=string.lower(string.match(text or"","^%s*(.-)%s*$"))
    if text~="/vr"and text~="/unvr"then return end
    if requested[player]and tick()-requested[player]&lt;.5 then return end
    requested[player]=tick()
    if sessions[player]then leave(player,"toggle")elseif text=="/vr"then enter(player)end
end
require(script.Parent.VRChat).start(remote,C,function(player)return sessions[player]~=nil end,command)
local function setup(player)
    player.Chatted:connect(function(text)command(player,text)end)
    local function characterAdded(character)
        leave(player,"respawn")
        if C.AutoEnable and allowed(player)then spawn(function()
            local deadline=tick()+20
            repeat wait(.1)until(character and character:FindFirstChild("Torso"))or tick()&gt;deadline
            wait(2)
            if player.Character==character and player.Parent and not sessions[player]then enter(player)end
        end)end
    end
    player.CharacterAdded:connect(characterAdded)
    if player.Character and C.AutoEnable then characterAdded(player.Character)end
end
local function frame(a,positionLimit)
    if type(a)~="table"or #a~=12 then return nil end
    for i=1,12 do if type(a[i])~="number"or a[i]~=a[i]or math.abs(a[i])&gt;10000 then return nil end end
    if Vector3.new(a[1],a[2],a[3]).magnitude&gt;(positionLimit or C.MaxReach)then return nil end
    for row=0,2 do
        local length=0
        for col=0,2 do local x=a[4+row*3+col];length=length+x*x end
        if math.abs(length-1)&gt;.05 then return nil end
        for other=row+1,2 do
            local dot=0;for col=0,2 do dot=dot+a[4+row*3+col]*a[4+other*3+col]end
            if math.abs(dot)&gt;.05 then return nil end
        end
    end
    return CFrame.new(unpack(a))
end
local function apply(player,pose)
    local state=sessions[player]
    if not state then return end
    if not state.character.Parent or state.humanoid.Health&lt;=0 then leave(player,"death");return end
    if type(pose)~="table"or not pose.tracked or type(pose.seq)~="number"or pose.seq~=pose.seq or pose.seq&lt;0 or pose.seq&gt;=1000000 or pose.seq~=math.floor(pose.seq)or pose.seq==state.lastSequence then return end
    local head=frame(pose.head)
    if not head then return end
    state.lastSequence=pose.seq;state.lastPoseAt=tick()
    local root=state.root.CFrame
    local torsoFrame=state.torso.CFrame
    local eyesForward=type(pose.eyeForward)=="number"and pose.eyeForward==pose.eyeForward and math.max(.2,math.min(.65,pose.eyeForward))or .45
    if Body then
        local localTorso,yaw
        head,localTorso,yaw=Body.sample(head,state.bodyYaw or 0,tick()-(state.bodyAt or tick()-.05),eyesForward)
        state.bodyYaw=yaw;state.bodyAt=tick();torsoFrame=root*localTorso
    end
    local hands={left=frame(pose.left),right=frame(pose.right)}
    for _,row in ipairs(state.joints)do
        local target=row.key=="head"and head or hands[row.key]
        if row.key=="body"then row.weld.C0=root:toObjectSpace(torsoFrame)*row.weld.C1
        elseif target then
            if row.key~="head"then target=target*CFrame.Angles(math.rad(C.ArmRotationDegrees),0,0)*CFrame.new(0,1,0)end
            row.weld.C0=torsoFrame:toObjectSpace(root*target)*row.weld.C1
        else row.weld.C0=row.c0 end
    end
    if weapons then
        local mask=pose.buttons
        if type(mask)~="number"or mask~=mask or mask&lt;0 or mask&gt;255 or mask~=math.floor(mask)then mask=0 end
        local trackingRoot=frame(pose.trackingRoot,10000)
        if not trackingRoot or(trackingRoot.p-root.p).magnitude&gt;6 then trackingRoot=root end
        local releases={}
